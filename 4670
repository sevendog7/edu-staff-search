<style>
  :root{
    --dark:#1d2b53;
    --purple:#7e2553;
    --red:#ff004d;
    --orange:#ffa300;
    --yellow:#ffec27;
    --green:#00e436;
    --darkgreen:#008751;
    --blue:#29adff;
    --skylight:#c2f1ff;
    --white:#fff1e8;
    --grey:#8a8fa3;
    --panel-w: min(1320px, 96vw);
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ height:100%; }

  body{
    background:var(--dark);
    color:var(--white);
    font-family:'DungGeunMo', monospace;
    image-rendering:pixelated;
    position:relative;
  }

  /* 콘솔 베젤 픽셀 코너 */
  body::before, body::after,
  .corner-tl, .corner-tr, .corner-bl, .corner-br{ content:""; }
  .corner-tl, .corner-tr, .corner-bl, .corner-br{
    position:fixed; width:14px; height:14px; z-index:5; pointer-events:none;
    background-image:
      linear-gradient(var(--white) 3px, transparent 3px),
      linear-gradient(90deg, var(--white) 3px, transparent 3px);
    background-repeat:no-repeat;
    opacity:.5;
  }
  .corner-tl{ top:6px; left:6px; background-position:0 0, 0 0; }
  .corner-tr{ top:6px; right:6px; transform:scaleX(-1); background-position:0 0, 0 0; }
  .corner-bl{ bottom:6px; left:6px; transform:scaleY(-1); background-position:0 0, 0 0; }
  .corner-br{ bottom:6px; right:6px; transform:scale(-1,-1); background-position:0 0, 0 0; }

  /* 별가루 픽셀 텍스처 */
  .console{
    position:relative;
    background-image:
      radial-gradient(1.5px 1.5px at 8% 18%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 22% 62%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 38% 30%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 54% 80%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 68% 12%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 82% 55%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 92% 88%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 14% 92%, var(--white) 0 100%, transparent 100%),
      radial-gradient(1.5px 1.5px at 46% 6%, var(--white) 0 100%, transparent 100%);
    background-repeat:no-repeat;
    opacity:1;
  }
  .console::before{
    content:""; position:absolute; inset:0; background:inherit; opacity:.16; pointer-events:none; z-index:0;
  }

  @media (min-width:769px){
    body{ height:100vh; overflow:hidden; display:flex; flex-direction:column; }
    .wrap{ width:100%; height:100%; display:flex; flex-direction:column; min-height:0; }
    header.cover{ flex:0 0 auto; }
    .console{ flex:1 1 auto; display:flex; flex-direction:column; min-height:0; padding: clamp(10px, 1.8vh, 18px) 0; }
    .inner{ position:relative; z-index:1; width:var(--panel-w); margin:0 auto; height:100%; display:flex; flex-direction:column; min-height:0; }
    .body-flow{ flex:1 1 auto; display:flex; flex-direction:column; min-height:0; justify-content:space-between; gap: clamp(6px, 1.2vh, 14px); }
    section{ flex:0 1 auto; display:flex; flex-direction:column; justify-content:center; min-height:0; }
    footer{ flex:0 0 auto; }
  }
  @media (max-width:768px){
    body{ min-height:100%; }
    .console{ padding:16px 0 60px; }
    .inner{ position:relative; z-index:1; width:var(--panel-w); margin:0 auto; }
  }

  /* ---------- HERO : 8비트 풍경 배너 ---------- */
  header.cover{
    position:relative;
    height: clamp(120px, 24vh, 240px);
    overflow:hidden;
    border-bottom:4px solid var(--white);
    box-shadow: 0 4px 0 var(--dark), 0 8px 0 var(--white);
  }
  header.cover svg{ position:absolute; inset:0; width:100%; height:100%; display:block; shape-rendering:crispEdges; }
  header.cover .hero-text{
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:10px;
    text-align:center;
    padding:0 16px;
  }
  h1.title{
    font-family:'DungGeunMo', monospace;
    font-size: clamp(30px, 5.6vh, 54px);
    line-height:1;
    color:var(--white);
    text-shadow:
      3px 0 0 var(--dark), -3px 0 0 var(--dark),
      0 3px 0 var(--dark), 0 -3px 0 var(--dark),
      3px 3px 0 var(--dark), -3px -3px 0 var(--dark),
      3px -3px 0 var(--dark), -3px 3px 0 var(--dark);
  }
  .hero-text .press{
    font-family:'Press Start 2P', monospace;
    font-size: clamp(8px, 1vw, 11px);
    color:var(--yellow);
    text-shadow:2px 2px 0 var(--dark);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink{ 50%{ opacity:.25; } }
  @media (prefers-reduced-motion: reduce){ .press{ animation:none; } }

  /* ---------- SECTION HEADING ---------- */
  .section-head{
    display:flex; align-items:center; gap:9px;
    margin-bottom: clamp(7px, 1.2vh, 12px);
    flex:0 0 auto;
  }
  .coin, .spr{ flex-shrink:0; shape-rendering:crispEdges; }
  .coin{ width: clamp(18px, 2.4vh, 24px); height: clamp(18px, 2.4vh, 24px); }
  .spr-star{ width: clamp(12px, 1.6vh, 16px); height: clamp(12px, 1.6vh, 16px); }
  .section-head h2{
    font-family:'DungGeunMo', monospace;
    font-size: clamp(16px, 2.2vh, 23px);
    color:var(--yellow);
  }
  .section-head .rule{
    flex:1; height:4px;
    background: repeating-linear-gradient(90deg, var(--white) 0 6px, transparent 6px 10px);
    opacity:.35;
  }
  .section-head .tag{
    display:flex; align-items:center; gap:6px;
    font-family:'Press Start 2P', monospace;
    font-size: clamp(8px, .8vw, 10px);
    color:var(--grey);
    white-space:nowrap;
  }
  @media (max-width:900px){ .section-head .tag span{ display:none; } }

  /* ---------- CARDS : 메뉴 아이템 (높이 고정/통일) ---------- */
  .grid-cards{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(8px, 1.1vh, 12px);
  }

  a.card{
    position:relative;
    display:flex; flex-direction:column; justify-content:space-between;
    height: clamp(80px, 10.4vh, 106px);
    padding: clamp(9px, 1.3vh, 14px) clamp(11px, 1.1vw, 15px);
    text-decoration:none; color:var(--white);
    background: rgba(255,241,232,.06);
    border:3px solid var(--white);
    clip-path: polygon(0 6px, 6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%);
    box-shadow: 4px 4px 0 rgba(0,0,0,.35);
    overflow:hidden;
  }
  a.card .idx{
    font-family:'Press Start 2P', monospace;
    font-size: clamp(8px, .78vw, 10px);
    color:var(--blue);
    flex:0 0 auto;
  }
  a.card h3{
    font-family:'DungGeunMo', monospace;
    font-size: clamp(13.5px, 1.35vw, 17px);
    line-height:1.26;
    margin-top: clamp(3px, .7vh, 6px);
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
    flex:1 1 auto;
  }
  a.card .domain{
    margin-top: clamp(4px, .8vh, 8px);
    font-family:'Press Start 2P', monospace;
    font-size: clamp(7px, .64vw, 8.5px);
    color:var(--grey);
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    flex:0 0 auto;
  }
  a.card:hover{
    background:var(--blue);
    border-color:var(--white);
    color:var(--dark);
  }
  a.card:hover .idx{ color:var(--dark); }
  a.card:hover .domain{ color:var(--dark); }
  a.card:active{ background:var(--red); }
  a.card:focus-visible{ outline:3px solid var(--yellow); outline-offset:2px; }

  footer{
    margin-top: clamp(7px, 1.2vh, 14px);
    padding-top: clamp(6px, 1vh, 10px);
    border-top:3px solid var(--white);
    display:flex; justify-content:space-between; align-items:center;
    font-family:'Press Start 2P', monospace;
    font-size: clamp(8px, .8vw, 10px);
    color:var(--grey);
    flex:0 0 auto;
    gap:8px;
  }
  footer .name{ color:var(--yellow); display:flex; align-items:center; gap:8px; }
  footer .spr-star{ width:14px; height:14px; }

  @media (prefers-reduced-motion: reduce){ .press{ animation:none; } }

  @media (max-width:768px){
    header.cover{ height:150px; }
    h1.title{ font-size:clamp(24px, 8vw, 34px); }
    .section-head .tag span{ display:none; }
    .grid-cards{ grid-template-columns:repeat(2, 1fr); }
    a.card{ height:112px; }
    .body-flow > section{ margin-bottom:14px; }
  }
  @media (max-width:420px){
    .grid-cards{ grid-template-columns:1fr; }
  }
</style>
</head>
